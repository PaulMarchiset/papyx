{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papyx",
  "version": "1.0.0",
  "identifier": "com.paulm.papyx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Papyx",
        "width": 1000,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PaulMarchiset/papyx/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NjQ4MkZDRDY5MjUwOEIKUldTTFVKTFcvSUprV1ZxbnRaZ25wY1YveDBqVzhzcVBtc3JxVkp1MVJNZG9wbVkyck9zeHhjemQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Paul Marchiset",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
